# --- Server ---
APP_ENV=development
API_PORT=3001

# --- Database (Postgres) ---
DATABASE_URL=postgres://user:password@localhost:5432/kas_vmr?sslmode=disable

# --- Redis (refresh token store) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# REQUIRED - the app refuses to start if these are missing. Unlike the
# original Node.js code, there is no insecure hardcoded fallback.
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# --- Dues / kas business rules ---
IURAN_AMOUNT=20000
START_MONTH=10
START_YEAR=2025
SET_DEFAULT_PIN=123456

# --- Payment proof OCR ---
# Name (or part of it) that must appear in the OCR'd payment-proof text to
# be accepted, e.g. the treasurer's name as it appears on transfer
# receipts. Leave empty to disable this check entirely.
BENDAHARA_NAME_KEYWORD=riki ramadhani

# --- File uploads ---
UPLOAD_DIR=./uploads

# --- Nominal unik (auto-confirm via email) ---
# Member transfers `n * IURAN_AMOUNT + memberID` instead of a plain
# multiple of IURAN_AMOUNT, so their identity can be recovered purely
# from the transferred amount. Must evenly divide IURAN_AMOUNT.
UNIQUE_CODE_BASE=1000

# --- Mail watcher (auto-confirm via SeaBank "transfer masuk" email) ---
MAIL_WATCHER_ENABLED=false
MAIL_IMAP_HOST=imap.gmail.com:993
# Gmail address that receives SeaBank notification emails.
MAIL_USERNAME=kas.rt@gmail.com
# Generate via Google Account > Security > 2-Step Verification > App
# Passwords. NOT your normal Gmail password.
MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_SENDER_FILTER=notification@seabank.co.id
# Fallback poll interval (seconds) if IMAP IDLE isn't supported, and the
# interval at which the IDLE session itself is refreshed.
MAIL_POLL_INTERVAL_SECONDS=120
